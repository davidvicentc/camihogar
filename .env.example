# ── Base de datos ─────────────────────────────────────────────
# MongoDB Atlas: crea un cluster gratuito en https://cloud.mongodb.com
MONGODB_URI="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/camihogar?retryWrites=true&w=majority"

# ── Cloudinary ────────────────────────────────────────────────
# Panel: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu-cloud-name"

# ── WhatsApp Business ─────────────────────────────────────────
# Número en formato internacional sin "+" ni espacios (ej. Venezuela: 58412XXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER="584120000000"

# ── Admin ─────────────────────────────────────────────────────
ADMIN_PASSWORD="cambia-esta-clave"
# Cadena aleatoria larga para firmar la cookie de sesión (openssl rand -hex 32)
AUTH_SECRET="cambia-este-secreto-largo-y-aleatorio"

# ── Sitio ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
